+        uint32_t function = CONFIG_MACH_GD32E23X ? 1 : 4;
+        uint32_t gpio_mode = GPIO_FUNCTION(function) | GPIO_OPEN_DRAIN;
+        gpio_peripheral(ii->scl_pin, gpio_mode, 1);
+        gpio_peripheral(ii->sda_pin, gpio_mode, 1);
         i2c->CR1 = I2C_CR1_SWRST;
