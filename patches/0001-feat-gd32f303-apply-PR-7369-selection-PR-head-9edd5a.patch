diff --git a/src/generic/armcm_timer.c b/src/generic/armcm_timer.c
index e2d77924..35fd18e0 100644
--- a/src/generic/armcm_timer.c
+++ b/src/generic/armcm_timer.c
@@ -36,7 +36,11 @@ timer_set_diff(uint32_t value)
 {
     SysTick->LOAD = value;
     SysTick->VAL = 0;
+#if !CONFIG_MACH_GD32F303XX
+    // Most chips generate a one-shot interrupt after clearing LOAD here.
+    // GD32F303 requires LOAD to remain set for the interrupt to trigger.
     SysTick->LOAD = 0;
+#endif
 }
 
 // Return the current time (in absolute clock ticks).
